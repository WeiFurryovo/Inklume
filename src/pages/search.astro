---
import { getRelativeLocaleUrl } from "astro:i18n";
import { PFSearch } from "astro-pure/components/pages";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (config.features.search !== "pagefind" && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const t = useTranslations(locale);
const postsUrl = getRelativeLocaleUrl(locale, "posts");
---

<Layout pageTitle={t.pages.searchTitle}>
  <Header />

  <div class="w-full flex-1">
    <Breadcrumb href={postsUrl} />

    <main id="main-content" class="mt-6 lg:mt-10">
      <div id="content-header" class="animate">
        <h1 class="mb-6 text-3xl font-medium">{t.pages.searchTitle}</h1>
      </div>

      <div id="content" class="animate">
        <p>{t.pages.searchDesc}</p>
        <PFSearch />
      </div>
    </main>
  </div>

  <Footer />
</Layout>
