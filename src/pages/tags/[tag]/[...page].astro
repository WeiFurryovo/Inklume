---
import type { GetStaticPathsOptions } from "astro";
import TaxonomyPostsPage from "@/components/TaxonomyPostsPage.astro";
import { getTaxonomyStaticPaths } from "@/utils/getTaxonomy";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  return getTaxonomyStaticPaths("tags", "zh", paginate);
}

const { page, term, redirectTo } = Astro.props;
if (redirectTo) return Astro.redirect(redirectTo, 301);
---

<TaxonomyPostsPage locale="zh" kind="tags" {page} {term} />
