---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection(
  "posts",
  ({ id, data }) => id.startsWith("zh/") && !data.draft
);
const tags = getUniqueTags(posts);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const postsUrl = getRelativeLocaleUrl(locale, "posts");
const empty = "还没有标签。";
---

<Layout title={`${t.pages.tagsTitle} | ${config.site.title}`}>
  <Header />

  <div class="w-full flex-1">
    <Breadcrumb href={postsUrl} />

    <main id="main-content" class="mt-6 lg:mt-10">
      <div id="content-header" class="animate">
        <h1 class="mb-6 text-3xl font-medium">{t.pages.tagsTitle}</h1>
      </div>

      <div id="content" class="animate">
        {
          tags.length > 0 ? (
            <ul class="flex flex-wrap gap-4">
              {tags.map(({ tag, tagName, count }) => (
                <Tag {tag} {tagName} {count} />
              ))}
            </ul>
          ) : (
            <p>{empty}</p>
          )
        }
      </div>
    </main>
  </div>

  <Footer />
</Layout>
