---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import PostListPage from "@/components/PostListPage.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getTaxonomySummaries } from "@/utils/getTaxonomy";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection(
    "posts",
    ({ id, data }) => id.startsWith("zh/") && !data.draft
  );
  const sortedPosts = getSortedPosts(posts);
  return paginate(sortedPosts, {
    pageSize: config.posts.perPage,
    props: {
      tags: await getUniqueTags(posts, "zh"),
      categories: await getTaxonomySummaries("categories", posts, "zh"),
      postsCount: sortedPosts.length,
    },
  });
}) satisfies GetStaticPaths;

const { page, tags, categories, postsCount } = Astro.props;
---

<PostListPage locale="zh" {page} {tags} {categories} {postsCount} />
