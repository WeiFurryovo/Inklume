---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import { BackToTop } from "astro-pure/components/pages";
import { Button } from "astro-pure/user";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Gallery from "@/components/Gallery.astro";
import { getGalleryAlbums } from "@/utils/getGalleryAlbums";
import { useTranslations } from "@/i18n";
import config from "@/config";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }];
}

const locale = Astro.currentLocale ?? config.site.lang;

// Redirect to 404 page if the gallery feature is disabled.
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (!config.features.gallery.enabled && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const t = useTranslations(locale);

const posts = await getCollection("posts", ({ id }) => id.startsWith("en/"));
const albums = getGalleryAlbums(posts);
---

<Layout
  title={`${t.pages.galleryTitle} | ${config.site.title}`}
  description={t.pages.galleryDesc}
>
  <Header />

  <div class="w-full flex-1">
    <Button
      title={t.post.goBack}
      href={getRelativeLocaleUrl(locale, "")}
      variant="back"
    />

    <main
      id="main-content"
      class="mt-6 items-start gap-x-10 md:flex lg:mt-10"
      data-pagefind-body
    >
      <article class="min-w-0 grow">
        <div id="content-header" class="animate">
          <h1 class="text-2xl font-medium sm:mb-2 sm:text-3xl">
            {t.pages.galleryTitle}
          </h1>
          <p class="text-muted-foreground mt-2 text-sm sm:text-base">
            {t.pages.galleryDesc}
          </p>
        </div>

        <div
          id="content"
          class="animate mt-8 max-w-none overflow-x-hidden"
          data-back-to-top-label={t.post.backToTop}
        >
          <Gallery albums={albums} />
        </div>
      </article>
    </main>

    <BackToTop header="content-header" content="content" />
  </div>

  <Footer />
</Layout>

<script>
  import { localizeBackToTop } from "@/scripts/localizeBackToTop";

  localizeBackToTop();
  document.addEventListener("astro:page-load", localizeBackToTop);
</script>
