---
import type { IconsType } from "astro-pure/types";
import { Icon } from "astro-pure/user";

type Stat = {
  platform: string;
  icon: IconsType;
  color?: string;
  href: string;
  metric?: string;
  api?: string;
};

type ResolvedStat = Stat & {
  count?: number;
};

type Props = {
  locale: string;
  stats: Stat[];
};

const { locale, stats } = Astro.props;
const copy =
  locale === "zh"
    ? { poweredBy: "构建时更新，数据来自" }
    : {
        poweredBy: "Updated at build time; powered by",
      };

async function resolveStat(item: Stat): Promise<ResolvedStat> {
  if (!item.api) return item;

  try {
    const response = await fetch(`https://api.swo.moe/stats/${item.api}`, {
      signal: AbortSignal.timeout(5_000),
    });
    if (!response.ok) {
      throw new Error(`HTTP ${response.status}`);
    }

    const data = (await response.json()) as {
      failed?: boolean;
      count?: unknown;
      message?: string;
    };
    if (data.failed || typeof data.count !== "number") {
      throw new Error(data.message ?? "Invalid Substats response");
    }

    return { ...item, count: data.count };
  } catch (error) {
    // eslint-disable-next-line no-console -- keep build failures visible while using the fallback.
    console.error(`Error fetching Substats for ${item.platform}:`, error);
    return item;
  }
}

const resolvedStats = await Promise.all(stats.map(resolveStat));
---

<div
  class="not-prose grid grid-cols-1 gap-3 rounded-xl border p-2 sm:grid-cols-2 sm:p-3"
>
  {
    resolvedStats.map(({ href, platform, icon, color, count, metric }) => (
      <a
        class="group text-muted-foreground no-underline"
        href={href}
        target={/^https?:\/\//i.test(href) ? "_blank" : undefined}
        rel={/^https?:\/\//i.test(href) ? "noopener noreferrer" : undefined}
      >
        <span class="hover:border-border hover:bg-muted flex items-center gap-3 rounded-lg border border-transparent px-3 py-2 transition-all">
          <Icon name={icon} color={color} />
          <span class="text-foreground group-hover:text-primary flex-1 transition-colors">
            {platform}
          </span>
          {typeof count === "number" && (
            <span class="flex min-w-20 items-center justify-end gap-1.5">
              <samp>{new Intl.NumberFormat(locale).format(count)}</samp>
              {metric && <span class="text-sm font-normal">{metric}</span>}
            </span>
          )}
        </span>
      </a>
    ))
  }
</div>
<div class="mt-2 text-right text-sm">
  {copy.poweredBy}
  <a
    class="text-muted-foreground"
    href="https://github.com/spencerwooo/substats"
    target="_blank"
    rel="noopener noreferrer">Substats</a
  >
</div>
