---
import type { IconsType } from "astro-pure/types";
import { Icon } from "astro-pure/user";

type Stat = {
  platform: string;
  icon: IconsType;
  color?: string;
  href: string;
  metric?: string;
  api?: string;
};

type Props = {
  locale: string;
  stats: Stat[];
};

const { locale, stats } = Astro.props;
const copy =
  locale === "zh"
    ? { loading: "正在载入统计数据", poweredBy: "实时显示，数据来自" }
    : {
        loading: "Loading statistics",
        poweredBy: "Displayed live; powered by",
      };
---

<div
  class="not-prose grid grid-cols-1 gap-3 rounded-xl border p-2 sm:grid-cols-2 sm:p-3"
  data-substats
>
  {
    stats.map(({ href, platform, icon, color, api, metric }) => (
      <a
        class="group text-muted-foreground no-underline"
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        data-substats-api={api}
      >
        <span class="hover:border-border hover:bg-muted flex items-center gap-3 rounded-lg border border-transparent px-3 py-2 transition-all">
          <Icon name={icon} color={color} />
          <span class="text-foreground group-hover:text-primary flex-1 transition-colors">
            {platform}
          </span>
          {api && (
            <span
              class="flex min-w-20 items-center justify-end gap-1.5"
              aria-label={copy.loading}
              aria-live="polite"
              data-substats-value
            >
              <samp>--</samp>
              {metric && <span class="text-sm font-normal">{metric}</span>}
            </span>
          )}
        </span>
      </a>
    ))
  }
</div>
<div class="mt-2 text-right text-sm">
  {copy.poweredBy}
  <a
    class="text-muted-foreground"
    href="https://github.com/spencerwooo/substats"
    target="_blank"
    rel="noopener noreferrer">Substats</a
  >
</div>

<script>
  function initSubstats() {
    document
      .querySelectorAll<HTMLElement>("[data-substats-api]")
      .forEach(card => {
        if (card.dataset.substatsReady === "true") return;
        card.dataset.substatsReady = "true";

        const api = card.dataset.substatsApi;
        const value = card.querySelector<HTMLElement>("[data-substats-value]");
        const count = value?.querySelector<HTMLElement>("samp");
        if (!api || !value || !count) return;

        const path = api
          .split("/")
          .map(segment => encodeURIComponent(segment))
          .join("/");

        fetch(`https://api.swo.moe/stats/${path}`)
          .then(response => {
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            return response.json();
          })
          .then(data => {
            if (data.failed || typeof data.count !== "number") {
              throw new Error(data.message ?? "Invalid Substats response");
            }
            count.textContent = new Intl.NumberFormat().format(data.count);
            value.removeAttribute("aria-label");
          })
          .catch(() => {
            value.hidden = true;
          });
      });
  }

  initSubstats();
  document.addEventListener("astro:page-load", initSubstats);
</script>
