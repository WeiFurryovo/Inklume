---
import { getEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { BackToTop, TOC } from "astro-pure/components/pages";
import { Button, Collapse, Icon, Spoiler, Timeline } from "astro-pure/user";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Substats from "@/components/about/Substats.astro";
import ToolSection from "@/components/about/ToolSection.astro";
import { useTranslations } from "@/i18n";

type Props = {
  locale: string;
};

const { locale } = Astro.props;
const t = useTranslations(locale);
const about = await getEntry("pages", `${locale}/about`);

if (!about) {
  throw new Error(
    `Missing content entry: \`${locale}/about.md\` in \`src/content/pages/\``
  );
}

const { Content, headings: contentHeadings } = await render(about);
const modules = about.data.aboutModules;
const headings = modules
  ? [
      ...contentHeadings,
      { depth: 2, slug: "site-stack", text: modules.siteStack.title },
      { depth: 2, slug: "social-networks", text: modules.social.title },
      { depth: 2, slug: "notes", text: modules.notes.title },
      { depth: 2, slug: "about-blog", text: modules.timeline.title },
    ]
  : contentHeadings;
const tocTitle = locale === "zh" ? "目录" : "TABLE OF CONTENTS";
const toggleToc =
  locale === "zh" ? "打开或关闭目录" : "Toggle table of contents";

const escapeHtml = (value: string) =>
  value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");

const timelineEvents =
  modules?.timeline.items.map(item => ({
    date: item.date,
    content: escapeHtml(item.content),
  })) ?? [];
---

<Layout
  pageTitle={about.data.title}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <div class="w-full flex-1">
    <Button
      title={t.post.goBack}
      href={getRelativeLocaleUrl(locale, "")}
      variant="back"
    />

    <main
      id="main-content"
      class="mt-6 items-start gap-x-10 md:flex"
      data-pagefind-body
    >
      <aside
        class="animate max-md:bg-muted top-20 z-40 min-w-48 basis-60 overflow-y-scroll max-md:fixed max-md:hidden max-md:rounded-xl max-md:border max-md:px-4 max-md:py-3 md:sticky md:order-2 lg:shrink-0"
        style="height:calc(100vh - 7rem);"
        id="sidebar"
        data-pagefind-ignore
      >
        {
          headings.length > 0 && (
            <>
              <h2 class="font-medium">{tocTitle}</h2>
              <TOC class="about-toc" {headings} />
            </>
          )
        }
      </aside>
      <div
        id="sidebar-shade"
        class="fixed start-0 top-0 h-full w-full"
        style="display:none;background-color:#00000091;z-index:31"
      >
      </div>

      <article class="min-w-0 grow">
        <div id="content-header" class="animate">
          <h1 class="text-2xl font-medium sm:mb-2 sm:text-3xl">
            {about.data.title}
          </h1>
        </div>

        <div
          id="content"
          class="app-prose prose animate mt-8 max-w-none overflow-x-hidden text-base md:min-w-[45ch]"
          data-back-to-top-label={t.post.backToTop}
        >
          <Content />

          {
            modules && (
              <>
                <p>
                  {modules.motto.text}{" "}
                  <Spoiler>{modules.motto.spoiler}</Spoiler>
                </p>
                <Button
                  as="a"
                  title={modules.cta.label}
                  class="w-fit"
                  href={modules.cta.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  variant="ahead"
                />

                <h2 id="site-stack">{modules.siteStack.title}</h2>
                <p>{modules.siteStack.description}</p>
                <ToolSection
                  class="mb-5"
                  title={modules.siteStack.groupLabel}
                  tools={modules.siteStack.items}
                />

                <h2 id="social-networks">{modules.social.title}</h2>
                <p>{modules.social.description}</p>
                <Substats locale={locale} stats={modules.social.items} />

                <h2 id="notes">{modules.notes.title}</h2>
                <Collapse title={modules.notes.summary}>
                  {modules.notes.body}
                </Collapse>

                <h2 id="about-blog">{modules.timeline.title}</h2>
                <p>{modules.timeline.description}</p>
                <Timeline events={timelineEvents} />
              </>
            )
          }
        </div>
      </article>
    </main>

    <BackToTop header="content-header" content="content">
      {
        headings.length > 0 && (
          <button
            slot="other-icons"
            type="button"
            aria-label={toggleToc}
            aria-controls="sidebar"
            aria-expanded="false"
            class="bg-muted text-muted-foreground hover:border-border/75 flex size-10 items-center justify-center rounded-full border-2 border-transparent duration-300 sm:size-12 md:hidden"
            id="sidebar-btn"
          >
            <Icon name="list" />
          </button>
        )
      }
    </BackToTop>
  </div>

  <Footer />
</Layout>

<script>
  import { localizeBackToTop } from "@/scripts/localizeBackToTop";

  function initAboutSidebar() {
    localizeBackToTop();

    const button = document.querySelector<HTMLButtonElement>("#sidebar-btn");
    const sidebar = document.querySelector<HTMLElement>("#sidebar");
    const shade = document.querySelector<HTMLElement>("#sidebar-shade");
    if (!button || !sidebar || button.dataset.ready === "true") return;
    button.dataset.ready = "true";

    const close = (restoreFocus = false) => {
      sidebar.classList.remove("show");
      button.setAttribute("aria-expanded", "false");
      if (shade) shade.style.display = "none";
      if (restoreFocus) button.focus({ preventScroll: true });
    };
    const toggle = () => {
      const show = !sidebar.classList.contains("show");
      sidebar.classList.toggle("show", show);
      button.setAttribute("aria-expanded", String(show));
      if (shade) shade.style.display = show ? "block" : "none";
      if (show) {
        requestAnimationFrame(() =>
          sidebar.querySelector<HTMLAnchorElement>("a")?.focus()
        );
      }
    };

    button.addEventListener("click", toggle);
    shade?.addEventListener("click", () => close(true));
    sidebar.addEventListener("click", event => {
      if (event.target instanceof Element && event.target.closest("a")) {
        close(true);
      }
    });
    sidebar.addEventListener("keydown", event => {
      if (event.key === "Escape") close(true);
    });
  }

  function initAboutWidgets() {
    document
      .querySelectorAll<HTMLElement>("collapse-component")
      .forEach((collapse, index) => {
        const trigger = collapse.querySelector<HTMLElement>(".expand-title");
        const content = collapse.querySelector<HTMLElement>(".expand-content");
        if (!trigger || !content || trigger.dataset.ready === "true") return;
        trigger.dataset.ready = "true";

        content.id ||= `about-collapse-${index + 1}`;
        trigger.setAttribute("role", "button");
        trigger.setAttribute("tabindex", "0");
        trigger.setAttribute("aria-controls", content.id);

        const syncExpanded = () =>
          trigger.setAttribute(
            "aria-expanded",
            String(collapse.classList.contains("expanded"))
          );
        syncExpanded();
        new MutationObserver(syncExpanded).observe(collapse, {
          attributes: true,
          attributeFilter: ["class"],
        });

        trigger.addEventListener("keydown", event => {
          if (event.key !== "Enter" && event.key !== " ") return;
          event.preventDefault();
          trigger.click();
        });
      });

    document.querySelectorAll<HTMLElement>(".spoiler").forEach(spoiler => {
      spoiler.tabIndex = 0;
    });
  }

  initAboutSidebar();
  initAboutWidgets();
  document.addEventListener("astro:page-load", () => {
    initAboutSidebar();
    initAboutWidgets();
  });
</script>

<style>
  :global(.about-toc > h2) {
    display: none;
  }

  :global(.about-toc > ul) {
    margin-top: 1rem;
  }

  :global(.spoiler:focus-visible),
  :global(.expand-title[role="button"]:focus-visible) {
    color: inherit;
    outline: 2px dashed hsl(var(--accent));
    outline-offset: 2px;
  }

  @media (min-width: 48.0625rem) {
    #sidebar-shade {
      display: none !important;
    }
  }

  @media (max-width: 48rem) {
    #sidebar.show {
      display: block !important;
      top: 0 !important;
      right: 0;
      height: 100vh !important;
      min-width: 40vw;
      max-width: 75vw;
      padding-block: 1.5rem !important;
      border-top-right-radius: 0 !important;
      border-bottom-right-radius: 0 !important;
      opacity: 1;
      animation: 300ms sidebar-in both !important;
    }

    #sidebar-shade {
      display: block;
      animation: 300ms shade-in both;
    }
  }

  @media (max-width: 40rem) {
    #sidebar.show {
      min-width: 55vw;
    }
  }

  @keyframes sidebar-in {
    from {
      transform: translateX(50%);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes shade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
