---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-pure/user";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { useTranslations } from "@/i18n";
import { getHomepage } from "@/utils/getHomepage";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const home = await getHomepage(locale);

const menu = [
  { title: home.navigation.posts, path: "posts" },
  ...(config.features.gallery.enabled
    ? [{ title: home.navigation.gallery, path: "gallery" }]
    : []),
  ...(config.features.showArchives
    ? [{ title: home.navigation.archives, path: "archives" }]
    : []),
  { title: home.navigation.tags, path: "tags" },
  { title: home.navigation.about, path: "about" },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background fixed inset-s-4 -top-full z-[70] rounded-lg border px-3 py-2 shadow-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header-component
  class="group sticky top-4 z-50 mb-12 flex items-center justify-between rounded-xl border border-transparent max-md:z-30 max-sm:py-1 sm:rounded-2xl"
>
  <a
    class="z-30 text-xl font-medium group-[.not-top]:ms-2 sm:group-[.not-top]:ms-3"
    style="transition:margin-inline 0.3s"
    href={getRelativeLocaleUrl(locale, "")}
    aria-label={home.siteName}
  >
    {home.siteName}
  </a>

  <div class="flex items-center gap-x-2 sm:gap-x-1 md:gap-x-2">
    <div
      id="headerExpandContent"
      class="dark:group-[.expanded.not-top]:bg-muted max-sm:group-[.not-top]:border-border max-sm:group-[.expanded.not-top]:bg-background start-0 end-0 top-12 grid border border-transparent group-[.expanded]:opacity-100 group-[.not-top]:rounded-xl max-sm:absolute max-sm:opacity-0 max-sm:group-[.not-top]:px-4 max-sm:group-[.not-top]:py-2 sm:grid-rows-1"
    >
      <div
        class="flex flex-col items-center justify-center overflow-hidden sm:flex-row"
      >
        {
          menu.map(item => (
            <a
              href={getRelativeLocaleUrl(locale, item.path)}
              class="hover:text-primary w-full flex-none grow py-2 text-right font-medium transition-none sm:w-fit sm:px-3"
              data-astro-prefetch
            >
              {item.title}
            </a>
          ))
        }
        <div
          class="flex w-full grow flex-row justify-end gap-x-1 sm:w-fit sm:gap-x-2"
        >
          {
            config.features.search !== false && (
              <a
                class="grid size-9 place-items-center py-2 transition-none"
                href={getRelativeLocaleUrl(locale, "search")}
                title={t.nav.search}
                aria-label={t.nav.search}
              >
                <span class="sr-only">{t.nav.search}</span>
                <Icon name="search" class="size-5" />
              </a>
            )
          }
          <a
            class="grid size-9 place-items-center py-2 transition-none"
            href={getAssetPath("admin/")}
            title="Sveltia CMS"
            aria-label="Sveltia CMS"
            data-astro-reload
          >
            <span class="sr-only">Sveltia CMS</span>
            <Icon name="document" class="size-5" />
          </a>
          <LanguageSwitcher />
        </div>
      </div>
    </div>

    <div
      class="z-30 flex gap-x-4 group-[.not-top]:gap-x-2"
      style="transition:gap 0.3s"
    >
      {
        config.features.lightAndDarkMode && (
          <button
            id="toggleDarkMode"
            class="group/dark hover:bg-border box-content size-5 rounded-md border p-1.5 transition-colors sm:group-[.not-top]:rounded-xl"
            title={t.a11y.toggleTheme}
            aria-label={t.a11y.toggleTheme}
          >
            <span class="sr-only">{t.a11y.toggleTheme}</span>
            <Icon
              class="system group-hover/dark:text-primary size-5"
              name="computer"
            />
            <Icon
              class="light group-hover/dark:text-primary hidden size-5"
              name="sun"
            />
            <Icon
              class="dark group-hover/dark:text-primary hidden size-5"
              name="moon"
            />
          </button>
        )
      }
      <button
        id="toggleMenu"
        class="hover:bg-border rounded-md border p-1.5 transition-colors sm:hidden sm:group-[.not-top]:rounded-xl"
        aria-label={t.a11y.openMenu}
        data-open-label={t.a11y.openMenu}
        data-close-label={t.a11y.closeMenu}
        aria-expanded="false"
      >
        <span class="sr-only">{t.a11y.openMenu}</span>
        <Icon class="size-5" name="menu" />
      </button>
    </div>
  </div>
</header-component>

<script is:inline>
  (function () {
    var toggle = document.getElementById("toggleDarkMode");
    if (toggle)
      toggle.dataset.theme = localStorage.getItem("theme") || "system";
  })();
</script>

<script>
  import { setTheme, showToast } from "astro-pure/utils";

  class InklumeHeader extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready === "true") return;
      this.dataset.ready = "true";

      let previousScrollY = window.scrollY;
      const updateHeader = () => {
        this.classList.toggle("not-top", window.scrollY > 20);
        this.dataset.show = String(
          window.scrollY < 350 || window.scrollY < previousScrollY
        );
        previousScrollY = window.scrollY;
      };
      updateHeader();
      window.addEventListener("scroll", updateHeader, { passive: true });

      const darkModeButton = this.querySelector<HTMLElement>("#toggleDarkMode");
      darkModeButton?.addEventListener("click", () => {
        const newTheme = setTheme(undefined, true) ?? "system";
        darkModeButton.dataset.theme = newTheme;
        showToast({ message: `Set theme to ${newTheme}` });
      });

      const menuButton = this.querySelector<HTMLButtonElement>("#toggleMenu");
      menuButton?.addEventListener("click", () => {
        const expanded = this.classList.toggle("expanded");
        menuButton.setAttribute("aria-expanded", String(expanded));
        menuButton.setAttribute(
          "aria-label",
          expanded
            ? (menuButton.dataset.closeLabel ?? "Close menu")
            : (menuButton.dataset.openLabel ?? "Open menu")
        );
      });

      this.querySelectorAll<HTMLAnchorElement>("a").forEach(link => {
        link.addEventListener("click", () => {
          this.classList.remove("expanded");
          menuButton?.setAttribute("aria-expanded", "false");
        });
      });
    }
  }

  if (!customElements.get("header-component")) {
    customElements.define("header-component", InklumeHeader);
  }
</script>

<style>
  header-component {
    transition:
      padding 0.3s,
      transform 0.3s,
      margin-inline 0.3s,
      border 0.15s,
      background-color 0.15s;
  }

  header-component.not-top {
    border-color: hsl(var(--border));
    background-color: hsl(var(--background));
    padding-inline: 0.375rem;
    box-shadow:
      rgb(255 255 255 / 0) 0 0 0 0,
      rgb(24 24 27 / 0.08) 0 0 0 1px,
      rgb(39 39 42 / 0.08) 0 10px 15px -3px,
      rgb(39 39 42 / 0.08) 0 4px 6px -4px;
  }

  header-component[data-show="false"]:not(.expanded) {
    transform: translateY(-5rem);
  }

  :global(.dark) header-component.not-top {
    background-color: hsl(var(--muted));
  }

  @media (min-width: 50rem) {
    header-component.not-top {
      margin-inline: 8%;
    }
  }

  @media (max-width: 40rem) {
    #headerExpandContent {
      grid-template-rows: 0fr;
      transition:
        opacity 0.3s,
        padding 0.3s,
        border-color 0.15s,
        grid-template-rows 0.3s;
    }

    .expanded #headerExpandContent {
      grid-template-rows: 1fr;
    }

    .expanded.not-top #headerExpandContent {
      background-color: hsl(var(--background));
      box-shadow:
        rgb(255 255 255 / 0) 0 0 0 0,
        rgb(24 24 27 / 0.08) 0 0 0 1px,
        rgb(39 39 42 / 0.08) 0 10px 15px -3px,
        rgb(39 39 42 / 0.08) 0 4px 6px -4px;
    }

    :global(.dark) .expanded.not-top #headerExpandContent {
      background-color: hsl(var(--muted));
    }

    header-component #headerExpandContent::after {
      position: absolute;
      inset-inline: calc(-1rem - 1px);
      top: -5rem;
      bottom: 0;
      z-index: -1;
      box-sizing: content-box;
      border-bottom: 1px solid transparent;
      opacity: 0;
      visibility: hidden;
      content: "";
      transition: 0.3s;
    }

    header-component:not(.not-top) #headerExpandContent::after {
      bottom: -1rem;
      border-bottom-color: hsl(var(--border));
      background-color: hsl(var(--muted));
      opacity: 1;
      visibility: visible;
    }
  }

  #toggleDarkMode[data-theme="dark"] .system,
  #toggleDarkMode[data-theme="light"] .system {
    display: none;
  }

  #toggleDarkMode[data-theme="dark"] .dark,
  #toggleDarkMode[data-theme="light"] .light {
    display: block;
  }
</style>
