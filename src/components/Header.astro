---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-pure/user";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getAssetPath, stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { features, site } = config;
const locale = Astro.currentLocale ?? site.lang;
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);
const normalizedPath =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;
const currentPath = stripLocale(normalizedPath, locale);

const isActive = (path: string) => {
  const currentRoot = currentPath.split("/").filter(Boolean)[0];
  const targetRoot = path.split("/").filter(Boolean)[0];
  return currentPath === path || currentRoot === targetRoot;
};

const menu = [
  { title: t.nav.posts, path: "/posts" },
  { title: t.nav.tags, path: "/tags" },
  ...(features.showArchives
    ? [{ title: t.nav.archives, path: "/archives" }]
    : []),
  ...(features.gallery.enabled
    ? [{ title: t.nav.gallery, path: "/gallery" }]
    : []),
  { title: t.nav.about, path: "/about" },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-primary fixed inset-s-4 -top-full z-[70] rounded-lg border px-3 py-2 shadow-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header class="site-shell sticky top-0 z-50 pt-4">
  <div
    id="site-header"
    class="flex min-h-12 items-center justify-between rounded-2xl border border-transparent px-2 py-1.5 transition-all duration-300"
  >
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="group flex min-w-0 items-center gap-2 px-1 text-lg font-medium no-underline"
      aria-label={site.title}
    >
      <img
        src={getAssetPath("favicon.svg")}
        alt=""
        width="30"
        height="30"
        class="size-7 rounded-lg transition-transform group-hover:-rotate-6"
      />
      <span class="truncate">{site.title}</span>
    </a>

    <div class="flex items-center gap-2">
      <div
        id="nav-panel"
        class="bg-background absolute inset-x-4 top-[4.25rem] hidden flex-col rounded-xl border p-3 shadow-lg md:static md:flex md:flex-row md:items-center md:border-0 md:bg-transparent md:p-0 md:shadow-none"
      >
        <nav aria-label="Primary navigation">
          <ul class="flex flex-col md:flex-row md:items-center">
            {
              menu.map(item => (
                <li>
                  <a
                    href={getRelativeLocaleUrl(locale, item.path.slice(1))}
                    class:list={[
                      "block rounded-lg px-3 py-2 text-sm font-medium no-underline transition-colors",
                      isActive(item.path)
                        ? "bg-muted text-primary"
                        : "text-muted-foreground hover:bg-muted hover:text-foreground",
                    ]}
                    aria-current={isActive(item.path) ? "page" : undefined}
                  >
                    {item.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div
          class="border-border mt-2 flex items-center justify-end gap-1 border-t pt-2 md:ms-2 md:mt-0 md:border-s md:border-t-0 md:ps-2 md:pt-0"
        >
          {
            features.search !== false && (
              <a
                href={getRelativeLocaleUrl(locale, "search")}
                class="hover:bg-muted hover:text-primary grid size-9 place-items-center rounded-lg"
                title={t.nav.search}
                aria-label={t.nav.search}
              >
                <Icon name="search" class="size-5" />
              </a>
            )
          }
          <a
            href={getAssetPath("admin/")}
            data-astro-reload
            class="hover:bg-muted hover:text-primary grid size-9 place-items-center rounded-lg"
            title="Sveltia CMS"
            aria-label="Sveltia CMS"
          >
            <Icon name="document" class="size-5" />
          </a>
          <LanguageSwitcher />
        </div>
      </div>

      {
        features.lightAndDarkMode && (
          <button
            id="theme-toggle"
            class="hover:bg-muted hover:text-primary grid size-9 place-items-center rounded-lg border transition-colors"
            title={t.a11y.toggleTheme}
            aria-label={t.a11y.toggleTheme}
          >
            <Icon name="computer" class="theme-system size-5" />
            <Icon name="sun" class="theme-light hidden size-5" />
            <Icon name="moon" class="theme-dark hidden size-5" />
          </button>
        )
      }

      <button
        id="menu-toggle"
        class="hover:bg-muted hover:text-primary grid size-9 place-items-center rounded-lg border transition-colors md:hidden"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <Icon name="menu" class="size-5" />
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var button = document.getElementById("theme-toggle");
    if (button)
      button.dataset.theme = localStorage.getItem("theme") || "system";
  })();
</script>

<script>
  import { setTheme } from "astro-pure/utils";

  function initHeader() {
    const header = document.querySelector<HTMLElement>("#site-header");
    const menuButton =
      document.querySelector<HTMLButtonElement>("#menu-toggle");
    const themeButton =
      document.querySelector<HTMLButtonElement>("#theme-toggle");

    if (!header || header.dataset.ready === "true") return;
    header.dataset.ready = "true";

    const updateHeader = () => {
      header.dataset.scrolled = String(window.scrollY > 12);
    };
    updateHeader();
    window.addEventListener("scroll", updateHeader, { passive: true });

    menuButton?.addEventListener("click", () => {
      const expanded = header.dataset.expanded === "true";
      header.dataset.expanded = String(!expanded);
      menuButton.setAttribute("aria-expanded", String(!expanded));
      menuButton.setAttribute(
        "aria-label",
        expanded
          ? (menuButton.dataset.labelOpen ?? "Open menu")
          : (menuButton.dataset.labelClose ?? "Close menu")
      );
    });

    themeButton?.addEventListener("click", () => {
      themeButton.dataset.theme = setTheme(undefined, true) ?? "system";
    });
  }

  initHeader();
  document.addEventListener("astro:page-load", initHeader);
</script>

<style>
  #site-header[data-scrolled="true"],
  #site-header[data-expanded="true"] {
    border-color: hsl(var(--border));
    background: hsl(var(--background) / 0.9);
    box-shadow:
      0 1px 0 rgb(24 24 27 / 0.04),
      0 10px 24px rgb(24 24 27 / 0.08);
    backdrop-filter: blur(14px);
  }

  #site-header[data-expanded="true"] #nav-panel {
    display: flex;
  }

  #theme-toggle[data-theme="light"] .theme-system,
  #theme-toggle[data-theme="dark"] .theme-system {
    display: none;
  }

  #theme-toggle[data-theme="light"] .theme-light,
  #theme-toggle[data-theme="dark"] .theme-dark {
    display: block;
  }
</style>
