---
import type { HTMLAttributes } from "astro/types";

type Props = { disabled?: boolean } & HTMLAttributes<"a">;

const { disabled, class: className, ...attrs } = Astro.props;

const Button = disabled ? "span" : "a";
---

<Button
  aria-disabled={disabled}
  class:list={[
    "group border-border bg-muted text-muted-foreground inline-flex items-center gap-1 rounded-lg border px-2.5 py-1.5 text-sm no-underline transition-colors",
    { "hover:bg-card hover:text-primary": !disabled },
    className,
  ]}
  {...attrs}
>
  <slot />
</Button>
