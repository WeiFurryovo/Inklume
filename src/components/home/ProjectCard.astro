---
import { cn } from "astro-pure/utils";

type Props = {
  heading: string;
  subheading: string;
  image: string;
  alt?: string;
  href: string;
  class?: string;
};

const { heading, subheading, image, alt, href, class: className } = Astro.props;
---

<a
  class={cn(
    "project-card group relative flex flex-col justify-end overflow-hidden rounded-2xl border bg-muted transition-all hover:border-foreground/25 hover:shadow-sm",
    className
  )}
  href={href}
>
  <img
    src={image}
    alt={alt ?? heading}
    class="absolute size-full object-cover opacity-60 transition-opacity group-hover:opacity-100 dark:opacity-35"
    loading="lazy"
    decoding="async"
  />
  <div
    class="project-card-fg z-10 flex flex-col gap-y-0.5 px-5 pt-36 pb-4 transition-all"
  >
    <h2 class="text-lg font-medium">{heading}</h2>
    <p class="text-muted-foreground">{subheading}</p>
  </div>
</a>

<style>
  .project-card-fg {
    background-image: linear-gradient(
      to bottom in oklch,
      transparent 0%,
      hsl(var(--card)) 80%
    );
  }

  .project-card:hover .project-card-fg {
    background-image: linear-gradient(
      to bottom in oklch,
      transparent 0%,
      hsl(var(--card)) 100%
    );
  }
</style>
