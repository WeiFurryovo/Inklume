---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import { Icon } from "astro-pure/user";
import config from "@/config";
import { useTranslations } from "@/i18n";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
};

const {
  pubDatetime,
  modDatetime,
  class: className = "",
  timezone: postTimezone,
} = Astro.props;

const t = useTranslations(Astro.currentLocale);

const timeZone = postTimezone ?? config.site.timezone;
const published = dayjs(pubDatetime).tz(timeZone);
const modified = modDatetime ? dayjs(modDatetime).tz(timeZone) : null;
const formatter = new Intl.DateTimeFormat(
  Astro.currentLocale ?? config.site.lang,
  {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone,
  }
);
---

<div class:list={["flex items-center gap-1", className]}>
  <Icon name="calendar" class="size-5" />
  <time class="font-sans" datetime={published.toISOString()}>
    {formatter.format(published.toDate())}
  </time>
  {
    modified && (
      <div class="flex items-center gap-1">
        <span> / </span>
        <span>
          {t.post.updatedAt}{" "}
          <time class="font-sans" datetime={modified.toISOString()}>
            {formatter.format(modified.toDate())}
          </time>
        </span>
      </div>
    )
  }
</div>
