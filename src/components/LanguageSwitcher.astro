---
import { Icon } from "astro-pure/user";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getAlternatePath, type Locale } from "@/i18n/helpers";
import { stripBase } from "@/utils/withBase";
import { getPostUrl } from "@/utils/getPostPaths";
import { postFilter } from "@/utils/postFilter";
import config from "@/config";

const locale = (Astro.currentLocale ?? config.site.lang) as Locale;
const target: Locale = locale === "zh" ? "en" : "zh";
const label = target === "zh" ? "切换到中文" : "Switch to English";

// Map the current path to its counterpart in the other language.
const currentPath = stripBase(Astro.url.pathname);
let href = getAlternatePath(currentPath, target);

if (/^\/(?:en\/)?posts\/.+/.test(currentPath)) {
  const targetPosts = (
    await getCollection("posts", ({ id }) => id.startsWith(`${target}/`))
  ).filter(postFilter);
  const hasTranslation = targetPosts.some(
    post => getPostUrl(post.id, post.filePath, target) === href
  );
  if (!hasTranslation) href = getRelativeLocaleUrl(target, "posts");
}
---

<a
  href={href}
  data-lang-switch={target}
  hreflang={target}
  class="hover:bg-muted hover:text-primary grid size-9 place-items-center rounded-lg transition-colors"
  title={label}
  aria-label={label}
>
  <Icon name="earth" class="size-5" />
</a>

<script>
  import { getAlternatePath, type Locale } from "@/i18n/helpers";

  // Remember the manual language choice so the redirect script in Layout
  // honours it on subsequent visits.
  function bindLangSwitch() {
    document
      .querySelectorAll<HTMLAnchorElement>("a[data-lang-switch]")
      .forEach(a => {
        a.addEventListener("click", () => {
          const target = a.getAttribute("data-lang-switch");
          if (target === "zh" || target === "en") {
            localStorage.setItem("preferredLang", target);
            const backUrl = sessionStorage.getItem("backUrl");
            if (backUrl) {
              sessionStorage.setItem(
                "backUrl",
                getAlternatePath(backUrl, target as Locale)
              );
            }
          }
        });
      });
  }
  bindLangSwitch();
  document.addEventListener("astro:after-swap", bindLangSwitch);
</script>
