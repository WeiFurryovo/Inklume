---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-pure/user";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "bg-muted text-muted-foreground hover:bg-card hover:text-primary flex items-center gap-0.5 rounded-xl border px-2 py-1 no-underline transition-colors",
      { "text-sm": size === "sm" },
      { "text-lg": size === "lg" },
    ]}
  >
    <Icon
      name="hashtag"
      class:list={[
        "opacity-80",
        { "size-5": size === "lg" },
        { "size-4": size === "sm" },
      ]}
    />
    {tagName}
  </a>
</li>
