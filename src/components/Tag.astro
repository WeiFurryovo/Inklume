---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Button } from "astro-pure/user";
import { cn } from "astro-pure/utils";
import config from "@/config";
import type { TaxonomyKind, TaxonomySummary } from "@/utils/getTaxonomy";

type Props = {
  term: TaxonomySummary;
  kind?: TaxonomyKind;
};

const { term, kind = "tags" } = Astro.props;
const { slug, name, count } = term;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <Button
    href={getRelativeLocaleUrl(locale, `${kind}/${slug}/`)}
    variant="pill"
    class={cn(
      "items-start gap-x-1",
      count > 2 ? "rounded-xl px-3 py-1 text-xl" : count > 1 && "text-lg"
    )}
  >
    {name}
    <span class={count > 2 ? "text-base" : "text-xs"}>{count}</span>
  </Button>
</li>
