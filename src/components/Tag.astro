---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Button } from "astro-pure/user";
import { cn } from "astro-pure/utils";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  count: number;
};

const { tag, tagName, count } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <Button
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    variant="pill"
    class={cn(
      "items-start gap-x-1",
      count > 2 ? "rounded-xl px-3 py-1 text-xl" : count > 1 && "text-lg"
    )}
  >
    {tagName}
    <span class={count > 2 ? "text-base" : "text-xs"}>{count}</span>
  </Button>
</li>
