---
import { type CollectionEntry, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { BackToTop, TOC } from "astro-pure/components/pages";
import { Button, Icon } from "astro-pure/user";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import PostHero from "./PostHero.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { getArticleImageInfo } from "@/utils/getGalleryAlbums";
import EditPost from "@/pages/posts/[...slug]/_components/EditPost.astro";
import ShareLinks from "@/pages/posts/[...slug]/_components/ShareLinks.astro";
import AdjacentPostNav from "@/pages/posts/[...slug]/_components/AdjacentPostNav.astro";
import PostImages from "@/pages/posts/[...slug]/_components/PostImages.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  locale: string;
  post: CollectionEntry<"posts">;
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { locale, post, prevPost, nextPost } = Astro.props;
const t = useTranslations(locale);
const ui =
  locale === "zh"
    ? {
        toc: "目录",
        toggleToc: "打开或关闭目录",
        headingLink: "链接到",
        copy: "复制",
        copied: "已复制",
      }
    : {
        toc: "Table of contents",
        toggleToc: "Toggle table of contents",
        headingLink: "Link to",
        copy: "Copy",
        copied: "Copied",
      };
const {
  title,
  description,
  ogImage: initialOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  heroImage,
  hideEditPost,
} = post.data;

const rendered = await render(post);
const { Content } = rendered;
const remarkPluginFrontmatter = rendered.remarkPluginFrontmatter as Record<
  string,
  unknown
>;
const headings = rendered.headings.filter(heading => heading.depth > 1);
const imageInfo = getArticleImageInfo(post.body ?? "");

let ogImageUrl: string | undefined;
if (typeof initialOgImage === "string") {
  ogImageUrl = initialOgImage;
} else if (initialOgImage?.src) {
  ogImageUrl = initialOgImage.src;
}

if (!ogImageUrl && locale !== "zh" && config.features.dynamicOgImage) {
  const postUrl = getPostUrl(post.id, post.filePath, locale).replace(
    /\/+$/,
    ""
  );
  ogImageUrl = `${postUrl}/index.png`;
}

const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  ogImage={ogImage}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
  highlightColor={heroImage?.color ?? "#659EB9"}
>
  <Header />

  {
    config.features.showBackButton && (
      <Button
        id="back-button"
        title={t.post.goBack}
        href={getRelativeLocaleUrl(locale, "posts")}
        variant="back"
      />
    )
  }

  <main
    id="main-content"
    class="mt-6 items-start gap-x-10 md:flex"
    data-pagefind-body
  >
    <aside
      class="animate max-md:bg-muted top-20 z-40 min-w-48 basis-60 overflow-y-auto max-md:fixed max-md:hidden max-md:border max-md:px-4 max-md:py-3 md:sticky md:order-2 lg:shrink-0"
      style="height:calc(100vh - 7rem)"
      id="sidebar"
      data-pagefind-ignore
    >
      {
        headings.length > 0 && (
          <>
            <h2 class="font-medium">{ui.toc}</h2>
            <TOC class="post-toc" {headings} />
          </>
        )
      }
    </aside>
    <div
      id="sidebar-shade"
      class="fixed inset-0 hidden bg-black/55"
      style="z-index:31"
    >
    </div>

    <article class="min-w-0 grow">
      <div id="content-header" class="animate">
        <PostHero {post} {locale} {remarkPluginFrontmatter} />
      </div>

      <div
        id="content"
        class="animate mt-8 max-w-none overflow-x-hidden md:min-w-[45ch]"
      >
        <div
          id="article"
          class="app-prose prose prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg) max-w-none"
          data-heading-link-label={ui.headingLink}
          data-copy-label={ui.copy}
          data-copied-label={ui.copied}
          data-back-to-top-label={t.post.backToTop}
          data-image-info={Object.keys(imageInfo).length
            ? JSON.stringify(imageInfo)
            : undefined}
        >
          <Content />
        </div>
        <PostImages />
      </div>
    </article>
  </main>

  <div class="mt-6 items-start gap-x-10 md:flex">
    <div class="text-muted-foreground flex-1 md:min-w-[50ch]">
      <hr class="my-6 border-dashed" />
      <EditPost class="mb-5 sm:hidden" {hideEditPost} {post} />
      <ShareLinks />
      <AdjacentPostNav {prevPost} {nextPost} />
    </div>
    <div class="min-w-48 basis-60"></div>
  </div>

  <BackToTop header="content-header" content="content">
    {
      headings.length > 0 && (
        <button
          slot="other-icons"
          aria-label={ui.toggleToc}
          class="bg-muted text-muted-foreground hover:border-border/75 flex size-10 items-center justify-center rounded-full border-2 border-transparent duration-300 sm:size-12 md:hidden"
          id="sidebar-btn"
        >
          <Icon name="list" />
        </button>
      )
    }
  </BackToTop>

  <Footer />
</PostLayout>

<script>
  function initPostPage() {
    const backButton =
      document.querySelector<HTMLAnchorElement>("#back-button");
    const backUrl = sessionStorage.getItem("backUrl");
    if (backButton && backUrl) backButton.href = backUrl;

    const sidebarButton =
      document.querySelector<HTMLButtonElement>("#sidebar-btn");
    const sidebar = document.querySelector<HTMLElement>("#sidebar");
    const shade = document.querySelector<HTMLElement>("#sidebar-shade");
    const article = document.querySelector<HTMLElement>("#article");

    const toTopButton =
      document.querySelector<HTMLButtonElement>("#to-top-btn");
    if (toTopButton && article?.dataset.backToTopLabel) {
      toTopButton.setAttribute("aria-label", article.dataset.backToTopLabel);
    }

    const closeSidebar = () => {
      sidebar?.classList.remove("show");
      shade?.classList.add("hidden");
    };
    const toggleSidebar = () => {
      if (!sidebar) return;
      const show = !sidebar.classList.contains("show");
      sidebar.classList.toggle("show", show);
      shade?.classList.toggle("hidden", !show);
    };

    if (sidebarButton && sidebarButton.dataset.ready !== "true") {
      sidebarButton.dataset.ready = "true";
      sidebarButton.addEventListener("click", toggleSidebar);
      shade?.addEventListener("click", closeSidebar);
    }

    document
      .querySelectorAll<HTMLElement>(
        "#article h2, #article h3, #article h4, #article h5, #article h6"
      )
      .forEach(heading => {
        if (!heading.id || heading.querySelector(".heading-link")) return;
        heading.classList.add("group");
        const link = document.createElement("a");
        link.className =
          "heading-link ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100";
        link.href = `#${heading.id}`;
        link.setAttribute(
          "aria-label",
          `${article?.dataset.headingLinkLabel ?? "Link to"} ${heading.textContent ?? "section"}`
        );
        link.textContent = "#";
        heading.appendChild(link);
      });

    document.querySelectorAll<HTMLPreElement>("#article pre").forEach(block => {
      if (block.querySelector(".copy-code")) return;
      const button = document.createElement("button");
      button.className =
        "copy-code absolute end-3 -top-3 rounded border border-muted bg-muted px-2 py-1 text-xs font-medium leading-4 text-foreground";
      button.textContent = article?.dataset.copyLabel ?? "Copy";
      block.style.position = "relative";
      block.setAttribute("tabindex", "0");
      block.appendChild(button);
      button.addEventListener("click", async () => {
        const code = block.querySelector("code")?.innerText ?? "";
        await navigator.clipboard.writeText(code);
        button.textContent = article?.dataset.copiedLabel ?? "Copied";
        window.setTimeout(
          () => (button.textContent = article?.dataset.copyLabel ?? "Copy"),
          700
        );
      });
    });
  }

  initPostPage();
  document.addEventListener("astro:page-load", initPostPage);
</script>

<style>
  #sidebar :global(.post-toc > h2) {
    display: none;
  }

  #sidebar :global(.post-toc > ul) {
    margin-top: 1rem;
  }

  #article > :global(h1:first-child) {
    display: none;
  }

  @media (min-width: 48.0625rem) {
    #sidebar-shade {
      display: none !important;
    }
  }

  @media (max-width: 48rem) {
    #sidebar.show {
      display: block !important;
      top: 0 !important;
      right: 0;
      height: 100vh !important;
      min-width: 55vw;
      max-width: 75vw;
      padding-block: 1.5rem !important;
      border-radius: 0 !important;
      opacity: 1;
      animation: 300ms sidebar-in both !important;
    }

    #sidebar-shade:not(.hidden) {
      display: block;
      animation: 300ms shade-in both;
    }
  }

  @keyframes sidebar-in {
    from {
      transform: translateX(50%);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes shade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
