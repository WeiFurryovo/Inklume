---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Button } from "astro-pure/user";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  href?: string;
};

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const { href = getRelativeLocaleUrl(locale, "") } = Astro.props;
---

{
  config.features.showBackButton && (
    <nav aria-label={t.post.goBack}>
      <Button title={t.post.goBack} {href} variant="back" />
    </nav>
  )
}
