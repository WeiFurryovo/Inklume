---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  class?: string;
  /** Album-app layout: ~80vw on desktop instead of the regular text width. */
  wide?: boolean;
};

const { pageTitle, pageDesc, class: className, wide = false } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main
  data-backUrl={backUrl}
  id="main-content"
  class:list={[wide ? "w-full" : "app-layout", "animate pb-4", className]}
>
  <div id="content-header">
    <h1 class="mt-6 text-3xl font-medium sm:mt-10">{pageTitle}</h1>
  </div>
  {
    pageDesc && (
      <p class="text-muted-foreground mt-2 mb-6 text-sm sm:text-base">
        {pageDesc}
      </p>
    )
  }
  <div id="content"><slot /></div>
</main>

<script>
  function rememberBackUrl() {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  }

  rememberBackUrl();
  document.addEventListener("astro:page-load", rememberBackUrl);
</script>
