---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  class?: string;
  /** Album-app layout: ~80vw on desktop instead of the regular text width. */
  wide?: boolean;
};

const { pageTitle, pageDesc, class: className, wide = false } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main
  data-backUrl={backUrl}
  id="main-content"
  class:list={[
    wide ? "app-layout-wide" : "app-layout",
    "pure-animate pt-8 pb-4",
    className,
  ]}
>
  <h1 class="text-3xl font-medium sm:text-4xl">{pageTitle}</h1>
  {
    pageDesc && (
      <p class="text-muted-foreground mt-2 mb-8 text-sm sm:text-base">
        {pageDesc}
      </p>
    )
  }
  <slot />
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
