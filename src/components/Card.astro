---
import { type CollectionEntry, render } from "astro:content";
import { Button, Icon } from "astro-pure/user";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import { formatReadingTime } from "@/utils/formatReadingTime";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  detailed?: boolean;
  class?: string;
} & CollectionEntry<"posts">;

const { detailed = false, class: className, id, data, filePath } = Astro.props;
const {
  title,
  description,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  draft,
  heroImage,
} = data;
const locale = Astro.currentLocale ?? config.site.lang;
const href = getPostUrl(id, filePath, locale);
const postDate = modDatetime ?? pubDatetime;
const date = new Intl.DateTimeFormat(locale, {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: timezone ?? config.site.timezone,
}).format(postDate);
const heroSrc = heroImage?.src;
const highlightStyle =
  detailed && heroImage?.color
    ? `--preview-highlight:${heroImage.color};--preview-highlight-bg:color-mix(in srgb,${heroImage.color} 18%,hsl(var(--background)))`
    : undefined;

let minutesRead: string | undefined;
if (detailed) {
  const rendered = await render(Astro.props);
  minutesRead = formatReadingTime(
    rendered.remarkPluginFrontmatter.minutesRead,
    locale
  );
}
---

<li class:list={["post-preview", className]} style={highlightStyle}>
  <a
    class:list={[
      "bg-background group hover:bg-muted hover:text-primary relative block w-full rounded-2xl border px-5 py-2.5 transition-colors ease-in-out",
      detailed && "max-sm:px-4 sm:py-5",
      detailed && heroSrc && "max-md:pt-24",
    ]}
    href={href}
    data-astro-prefetch
  >
    {
      detailed && heroSrc && (
        <img
          src={heroSrc}
          alt={heroImage?.alt || title}
          class="cover-image absolute end-0 top-0 z-0 h-2/3 w-full rounded-2xl object-cover opacity-50 transition-opacity duration-300 group-hover:opacity-70 md:h-full md:w-3/5"
          loading="lazy"
          decoding="async"
        />
      )
    }
    <div
      class:list={[
        "relative flex flex-col gap-1",
        !detailed && "sm:flex-row sm:items-center",
      ]}
      style="z-index:1"
    >
      <time
        class="text-muted-foreground min-w-[95px] font-mono text-xs"
        datetime={postDate.toISOString()}
      >
        {date}
      </time>

      <div class="flex flex-grow justify-between gap-3">
        <div class:list={[detailed && "font-medium"]}>
          {draft && <span class="text-red-500">(Draft) </span>}
          {title}
        </div>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="preview-redirect stroke-muted-foreground group-hover:stroke-primary my-1 shrink-0"
          aria-hidden="true"
        >
          <line
            x1="5"
            y1="12"
            x2="19"
            y2="12"
            class="translate-x-4 scale-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1 group-hover:scale-x-100"
          ></line>
          <polyline
            points="12 5 19 12 12 19"
            class="translate-x-0 transition-all duration-300 ease-in-out group-hover:translate-x-1"
          ></polyline>
        </svg>
      </div>

      {
        detailed && (
          <>
            <p
              class:list={[
                "text-muted-foreground line-clamp-2 text-sm sm:line-clamp-3",
                heroSrc && "sm:me-24",
              ]}
            >
              {description}
            </p>
            <div class="text-muted-foreground flex items-center gap-2 py-1 text-sm leading-4 italic">
              {minutesRead && (
                <span class="flex items-center gap-1">
                  <Icon name="time" class="size-4" />
                  {minutesRead}
                </span>
              )}
              <span class="flex items-center gap-1">
                <Icon name="earth" class="size-4" />
                {locale === "zh" ? "中文" : "English"}
              </span>
            </div>
            {tags.length > 0 && (
              <object title="Tags" aria-label="Tags">
                <ul class="tag-list mt-1 flex flex-wrap gap-2">
                  {tags.map(tag => (
                    <li>
                      <Button
                        as="a"
                        title={tag}
                        href={getRelativeLocaleUrl(
                          locale,
                          `tags/${slugifyStr(tag)}`
                        )}
                        variant="pill"
                      />
                    </li>
                  ))}
                </ul>
              </object>
            )}
          </>
        )
      }
    </div>
  </a>
</li>

<style>
  .post-preview:hover > a,
  .post-preview:hover .tag-list a {
    background-color: var(--preview-highlight-bg, hsl(var(--muted)));
  }

  .post-preview:hover > a,
  .post-preview:hover .tag-list a:hover {
    color: var(--preview-highlight, hsl(var(--primary)));
  }

  .post-preview:hover > a .preview-redirect {
    stroke: var(--preview-highlight, hsl(var(--primary)));
  }

  .cover-image {
    mask-image: linear-gradient(
      to right,
      rgb(0 0 0 / 0%) 0%,
      rgb(0 0 0 / 100%) 100%
    );
  }

  @media (max-width: 48rem) {
    .cover-image {
      mask-image: linear-gradient(
        to top,
        rgb(0 0 0 / 0%) 0%,
        rgb(0 0 0 / 100%) 100%
      );
    }
  }
</style>
