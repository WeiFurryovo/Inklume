---
import { Icon } from "astro-pure/user";
import config from "@/config";

const { site, socials } = config;

const items = socials.map(({ name, url, linkTitle }) => {
  const title =
    linkTitle ??
    (url.startsWith("mailto:") || name === "email"
      ? `Send an email to ${site.title}`
      : `${site.title} on ${name.charAt(0).toUpperCase() + name.slice(1)}`);
  return { name, url, title };
});
---

{
  items.map(({ name, url, title }) => (
    <a href={url} rel="me" class="sl-flex">
      <span class="sr-only">{title}</span>
      <Icon name={name} />
    </a>
  ))
}
