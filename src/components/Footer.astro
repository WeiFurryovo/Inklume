---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["site-shell pb-5", { "mt-auto pt-16": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border text-muted-foreground flex flex-col gap-4 border-t pt-5 text-sm sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
      <span>© {currentYear} {config.site.author}</span>
      <span aria-hidden="true">•</span>
      <span>{t.footer.allRightsReserved}</span>
      <span aria-hidden="true">•</span>
      <span>
        <a
          href="https://astro.build/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-foreground font-medium underline underline-offset-4"
          >Astro</a
        >
        &amp;
        <a
          href="https://github.com/cworld1/astro-theme-pure"
          target="_blank"
          rel="noopener noreferrer"
          class="text-foreground font-medium underline underline-offset-4"
          >Pure</a
        >
      </span>
    </div>
    <Socials />
  </div>
</footer>
