---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-pure/user";
import Socials from "./Socials.astro";
import { getHomepage } from "@/utils/getHomepage";
import config from "@/config";

type Props = HTMLAttributes<"footer">;

const { class: className, ...attrs } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const home = await getHomepage(locale);
const currentYear = new Date().getFullYear();
const rssHref = getRelativeLocaleUrl(locale, "rss.xml").replace(/\/+$/, "");
---

<footer class:list={["mx-auto mt-16 mb-5 w-full", className]} {...attrs}>
  <div class="border-t pt-5">
    <div
      class="flex items-center gap-y-3 max-sm:flex-col sm:justify-between sm:gap-y-0"
    >
      <div
        class="text-muted-foreground flex items-center gap-x-4 gap-y-2 max-sm:flex-col"
      >
        {
          home.footer.filings.length > 0 && (
            <div>
              {home.footer.filings.map((filing, index) => (
                <>
                  {filing.url ? (
                    <a
                      href={filing.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {filing.label}
                    </a>
                  ) : (
                    <span>{filing.label}</span>
                  )}
                  {index < home.footer.filings.length - 1 && (
                    <span class="mx-1" aria-hidden="true">
                      •
                    </span>
                  )}
                </>
              ))}
            </div>
          )
        }
        <div>© {currentYear} {home.footer.copyrightName}</div>
        <span>
          <a
            href="https://github.com/withastro/astro"
            target="_blank"
            rel="noreferrer"
          >
            Astro
          </a>
          &amp;
          <a
            href="https://github.com/cworld1/astro-theme-pure"
            target="_blank"
            rel="noreferrer"
          >
            Pure
          </a>
          theme powered
        </span>
      </div>

      <div class="flex items-center gap-x-4">
        <Socials />
        <a href={rssHref} rel="me" class="sl-flex">
          <span class="sr-only">RSS</span>
          <Icon name="rss" />
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    color: hsl(var(--foreground) / var(--un-text-opacity, 1));
    font-weight: 500;
    text-decoration: underline;
  }
</style>
