---
import { Font } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import { ThemeProvider } from "astro-pure/components/basic";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  highlightColor?: string;
  ogType?: "website" | "article";
};

const { site } = config;

const {
  title = site.title,
  description = site.description,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  highlightColor,
  ogType = "website",
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.site ?? Astro.url);
// Endpoint files are emitted without a trailing slash. Astro's locale helper
// normalizes regular pages to slash URLs, so normalize this file URL explicitly.
const rssHref = getRelativeLocaleUrl(
  Astro.currentLocale ?? config.site.lang,
  "rss.xml"
).replace(/\/+$/, "");
---

<!doctype html>
<html
  dir={site.dir ?? "ltr"}
  lang={Astro.currentLocale ?? site.lang}
  class="overflow-y-scroll scroll-smooth"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      Bilingual redirect: honour a manually chosen language (set by the language
      switcher) first, then fall back to the browser language on the site root.
      Explicit locale routes are never rewritten, so opening `/en/...` remains
      an explicit request for English content.
    -->
    <script is:inline>
      (function () {
        try {
          var parts = location.pathname.split("/").filter(Boolean);
          // Only negotiate the language on the unqualified site root. Once a
          // visitor follows a content or locale URL, preserve that URL exactly.
          if (parts.length > 0) return;

          var current = "zh";
          var pref = localStorage.getItem("preferredLang");
          var nav = (navigator.language || "").toLowerCase();
          var desired =
            pref ||
            (nav.indexOf("zh") === 0
              ? "zh"
              : nav.indexOf("en") === 0
                ? "en"
                : null);
          if (!desired || desired === current) return;
          if (parts[0] === "en") parts.shift();
          if (desired === "en") parts.unshift("en");
          var dest = "/" + parts.join("/");
          if (location.pathname.endsWith("/") && dest !== "/") dest += "/";
          if (dest !== location.pathname) location.replace(dest);
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={getAssetPath("favicon.svg")} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Pure's display font plus the existing code font. -->
    <Font
      cssVariable="--font-satoshi"
      preload={[{ subset: "latin", weight: 400, style: "normal" }]}
    />
    <Font
      cssVariable="--font-google-sans-code"
      preload={[{ subset: "latin", weight: 400, style: "normal" }]}
    />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="sitemap" href={getAssetPath("sitemap-index.xml")} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <!-- RSS autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL(rssHref, Astro.site)}
    />

    <meta name="theme-color" content="#f9fbfc" />

    <!-- Extra head content injected by child layouts (e.g. JSON-LD, article meta) -->
    <slot name="head" />

    {
      site.googleVerification && (
        <meta
          name="google-site-verification"
          content={site.googleVerification}
        />
      )
    }

    <!-- Set both theme conventions before paint for Pure and legacy widgets. -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const dark = stored === "dark" || (stored !== "light" && prefersDark);
        const root = document.firstElementChild;
        root?.setAttribute("data-theme", dark ? "dark" : "light");
        root?.classList.toggle("dark", dark);
      })();
    </script>

    <ThemeProvider />
  </head>
  <body
    class="bg-background font-app text-foreground selection:bg-primary/20 flex min-h-svh justify-center"
  >
    {
      highlightColor && (
        <div
          id="highlight-gradient"
          class="pointer-events-none absolute inset-x-0 top-0 z-0 h-screen opacity-25"
          style={`background-image:linear-gradient(${highlightColor},transparent)`}
        />
      )
    }
    <div
      id="main-container"
      class="relative z-10 flex min-h-svh w-full max-w-[70rem] flex-col justify-between"
    >
      <slot />
    </div>
  </body>
</html>

<style define:vars={{ highlightColor }}>
  :global(.highlight) {
    --highlight-fg: color-mix(
      in srgb,
      var(--highlightColor) 40%,
      hsl(var(--foreground))
    );
    color: var(--highlight-fg, hsl(var(--primary))) !important;
  }

  :global(.highlight-bg) {
    background-color: var(--highlightColor, hsl(var(--primary))) !important;
  }

  #main-container {
    padding-top: env(safe-area-inset-top);
    padding-left: calc(1rem + env(safe-area-inset-left));
    padding-right: calc(1rem + env(safe-area-inset-right));
  }

  @media (min-width: 40rem) {
    #main-container {
      padding-left: calc(1.75rem + env(safe-area-inset-left));
      padding-right: calc(1.75rem + env(safe-area-inset-right));
    }
  }

  @media (min-width: 64rem) {
    #main-container {
      padding-left: calc(2.5rem + env(safe-area-inset-left));
      padding-right: calc(2.5rem + env(safe-area-inset-right));
    }
  }
</style>
